{
    "name": "mybeast/audit-laravel",
    "description": "Laravel SDK for audit.my-beast.com: audit events written in your own transaction to an outbox, and shipped in order to one tamper-evident log.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "MyBeast\\Audit\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MyBeast\\Audit\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MyBeast\\Audit\\Laravel\\AuditServiceProvider"],
            "aliases": {}
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
