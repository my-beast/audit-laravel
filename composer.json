{
    "name": "mybeast/audit-laravel",
    "description": "Laravel SDK for MyBeast Audit (services.my-beast.com/audit): audit events written in your own transaction to an outbox, and shipped in order to one tamper-evident log.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mybeast", "laravel", "audit", "audit-log", "outbox"],
    "homepage": "https://my-beast.com",
    "support": {
        "issues": "https://github.com/my-beast/audit-laravel/issues",
        "source": "https://github.com/my-beast/audit-laravel"
    },
    "authors": [
        { "name": "MyBeast", "homepage": "https://my-beast.com" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "MyBeast\\Audit\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MyBeast\\Audit\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MyBeast\\Audit\\Laravel\\AuditServiceProvider"],
            "aliases": {}
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
